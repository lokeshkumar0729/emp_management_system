# Copy to .env and change every value. Never commit .env.
DB_ROOT_PASSWORD=change-me-root
DB_PASSWORD=change-me-app
# At least 32 characters. Generate one with:  openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-string-of-32-or-more-characters
# true inserts demo accounts and tasks on first start. Use false for anything real.
SEED_DATA=true
WEB_PORT=3000
